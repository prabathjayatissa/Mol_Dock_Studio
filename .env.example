# ---------------------------------------------------------------------------
# MolDock Studio environment template.
# Copy to .env and adjust. Never commit your real .env.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
MOLDOCK_ENV=development
MOLDOCK_LOG_LEVEL=INFO
# Where projects, imported structures and job artifacts are written.
# Relative paths are resolved from the backend working directory.
MOLDOCK_DATA_DIR=./data

# --- API / server ----------------------------------------------------------
MOLDOCK_HOST=127.0.0.1
MOLDOCK_PORT=8000
# Comma separated list of allowed browser origins for the SPA.
MOLDOCK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Persistence -----------------------------------------------------------
# SQLite for the local desktop deployment. PostgreSQL works unchanged:
#   postgresql+psycopg://moldock:moldock@localhost:5432/moldock
MOLDOCK_DATABASE_URL=sqlite:///./data/moldock.db

# --- Upload / safety limits ------------------------------------------------
MOLDOCK_MAX_UPLOAD_MB=200
MOLDOCK_MAX_ATOMS=500000
MOLDOCK_JOB_TIMEOUT_SECONDS=3600
MOLDOCK_MAX_CONCURRENT_JOBS=2

# --- Scientific backends ---------------------------------------------------
# docker | native   (informational: surfaced through /api/health)
MOLDOCK_SCIENTIFIC_BACKEND_MODE=native
# Path to an AutoDock Vina executable. Leave empty to auto-detect on PATH.
# Docking requires Vina; it is not available from PyPI wheels on macOS arm64.
MOLDOCK_VINA_BINARY=
# Path to an Open Babel (`obabel`) executable, used only for optional
# format conversions. Leave empty to auto-detect on PATH.
MOLDOCK_OBABEL_BINARY=
# RCSB PDB REST base URL used by the "fetch by PDB ID" feature.
MOLDOCK_RCSB_BASE_URL=https://files.rcsb.org/download
MOLDOCK_RCSB_TIMEOUT_SECONDS=30

# --- Molecular surface defaults -------------------------------------------
MOLDOCK_DEFAULT_PROBE_RADIUS=1.4
MOLDOCK_SURFACE_GRID_SPACING=0.8

# --- Frontend (Vite) -------------------------------------------------------
VITE_API_BASE_URL=/api

# --- Docker Compose --------------------------------------------------------
# linux/arm64  -> RDKit/gemmi work, AutoDock Vina wheel unavailable
# linux/amd64  -> full stack including AutoDock Vina (Rosetta emulation on
#                 Apple Silicon; slower, but every scientific service works)
MOLDOCK_PLATFORM=linux/arm64
MOLDOCK_INSTALL_VINA=0
MOLDOCK_BACKEND_PORT=8000
